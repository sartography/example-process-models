    <bpmn:scriptTask id="Activity_0sc9um2" name="Is it safe for me to exercise today?">
      <bpmn:outgoing>Flow_13yzqu7</bpmn:outgoing>
      <bpmn:script>url = "https://api.hyperbolic.xyz/v1/chat/completions"

hyperbolic_api_key = "ENTER YOUR KEY HERE"

headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer " + hyperbolic_api_key
}

data = {
    "messages": [{
      "role": "user",
      "content": "Is it safe to exercise outside today?"
    }],
    "model": "meta-llama/Llama-3.3-70B-Instruct",
    "max_tokens": 512,
    "temperature": 0.1,
    "top_p": 0.9
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0b3w3se" name="Ask the AI">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="url" />
            <spiffworkflow:parameter id="headers" type="any" value="headers" />
            <spiffworkflow:parameter id="data" type="any" value="data" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:postScript>message = api_response["body"]["choices"][0]["message"]["content"]</spiffworkflow:postScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10rvxap</bpmn:incoming>
      <bpmn:outgoing>Flow_01za4vd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_0n6jsrk" name="Is it safe for me to exercise today?">
      <bpmn:outgoing>Flow_0gpori6</bpmn:outgoing>
      <bpmn:script>url = "https://api.hyperbolic.xyz/v1/chat/completions"
headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJkYW5Ac3BpZmYud29ya3MiLCJpYXQiOjE3NTUzNjkxNjl9.xb88yYT9OnrcG4zmpi7yGVRts9HGz8mn8_dW6Txq67U"
}
data = {
    "messages": [{
      "role": "user",
      "content": "Is it safe to exercise outside today?"
    }],
    "model": "meta-llama/Llama-3.3-70B-Instruct",
    "max_tokens": 512,
