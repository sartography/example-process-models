    <bpmn:sequenceFlow id="Flow_0lnb03x" name="The Agentic Loop" sourceRef="Gateway_1oca83b" targetRef="Gateway_00sbhqx" />
    <bpmn:sequenceFlow id="Flow_12b1f2o" sourceRef="Activity_17vc4fn" targetRef="Gateway_00sbhqx" />
    <bpmn:sequenceFlow id="Flow_0wmu1kd" sourceRef="Gateway_00sbhqx" targetRef="Activity_0f3vf1a" />
    <bpmn:sequenceFlow id="Flow_0ptrgjx" sourceRef="Activity_0f3vf1a" targetRef="Activity_1qxawxs" />
    <bpmn:sequenceFlow id="Flow_0vdux9a" sourceRef="Activity_1qxawxs" targetRef="Gateway_1ltnks7" />
    <bpmn:sequenceFlow id="Flow_0vhfhef" name="All questions answered ..." sourceRef="Gateway_1ltnks7" targetRef="Activity_0shflpi">
      <bpmn:conditionExpression>is_complete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ffhwhd" sourceRef="Activity_0shflpi" targetRef="Event_1abc1ff" />
    <bpmn:dataObject id="DataObject_1qbzfph" name="shared_form" />
    <bpmn:dataObjectReference id="DataObjectReference_065x1rl" dataObjectRef="DataObject_1qbzfph" />
    <bpmn:endEvent id="Event_1cu1ybx">
      <bpmn:incoming>Flow_1do8zcr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1xcn4aq" name="already working with an agent?" sourceRef="Gateway_1ltnks7" targetRef="Activity_13kco7t">
      <bpmn:conditionExpression>workingWithAgent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:manualTask id="Activity_13kco7t" name="Gently end converstaion">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>Because you are dealing with another realtor already, we are legally required to send you back to them for more information about the properties you are looking for.  Thank you for contacting us.  </spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xcn4aq</bpmn:incoming>
      <bpmn:outgoing>Flow_1do8zcr</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_1do8zcr" sourceRef="Activity_13kco7t" targetRef="Event_1cu1ybx" />
    <bpmn:userTask id="Activity_0shflpi" name="Move on to next step">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>Here we can move on to the next set of questions, which will vary - we could do down different paths depending on if is sale, or purchase or both ... only asking questions as needed, and specific to what is happening.  And ALWAYS getting the answers we need. </spiffworkflow:instructionsForEndUser>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="intake-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="intake-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vhfhef</bpmn:incoming>
      <bpmn:outgoing>Flow_1ffhwhd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_0yljo7m" name="Form Preview">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="intake-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="intake-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
  </bpmn:process>
