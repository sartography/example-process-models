<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="Definitions_96f6665" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="3.0.0-dev">
  <bpmn:process id="Process_1761592590874" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1761592590874">
      <bpmn:outgoing>Flow_1n8ympx</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_06li2ed" name="Set up Schema">
      <bpmn:incoming>Flow_1n8ympx</bpmn:incoming>
      <bpmn:outgoing>Flow_17jqt1j</bpmn:outgoing>
      <bpmn:script>responses = {}
schema = {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Real Estate Caller Qualification",
  "type": "object",
  "required": ["workingWithAgent", "transactionType", "timeline"],
  "properties": {
    "workingWithAgent": {
      "type": "boolean",
      "description": "Is the caller currently working with another real estate agent?"
    },
    "agentDetails": {
      "type": "string",
      "description": "Name or details of current agent if applicable"
    },
    "transactionType": {
      "type": "string",
      "enum": ["buying", "selling", "renting", "investing", "both_buy_and_sell"],
      "description": "Type of real estate transaction"
    },
    "timeline": {
      "type": "string",
      "enum": ["immediate", "1-3_months", "3-6_months", "6-12_months", "exploring"],
      "description": "Timeframe for transaction"
    },
    "currentSituation": {
      "type": "string",
      "enum": ["homeowner", "renter", "living_with_family", "relocating"],
      "description": "Caller's current living situation"
    },
    "motivation": {
      "type": "string",
      "description": "Primary reason for buying/selling (e.g., upsizing, downsizing, job relocation, divorce, financial distress, investment)"
    },
    "priceRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "locationPreference": {
      "type": "string",
      "description": "Desired area or neighborhood"
    },
    "urgencyLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "How urgent is their need"
    }
  }
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_0dhnjj9z" name="Request More Information">
      <bpmn:extensionElements>
        <spiffworkflow:postScript># add in the new response from the LLM
data["messages"].append({"role":"assistant", "content": user_message})

# Add in the new prompt from the person
data["messages"].append({"role":"user", "content": new_prompt})
</spiffworkflow:postScript>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="new_prompt-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="new_prompt-uischema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:instructionsForEndUser>{{user_message}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zzvof7</bpmn:incoming>
      <bpmn:outgoing>Flow_16lggho</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1oca83b">
      <bpmn:incoming>Flow_16lggho</bpmn:incoming>
      <bpmn:outgoing>Flow_0lnb03x</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_00sbhqx">
      <bpmn:incoming>Flow_0lnb03x</bpmn:incoming>
      <bpmn:incoming>Flow_12b1f2o</bpmn:incoming>
      <bpmn:outgoing>Flow_0wmu1kd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_17vc4fn" name="Configure the LLM">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17jqt1j</bpmn:incoming>
      <bpmn:outgoing>Flow_12b1f2o</bpmn:outgoing>
      <bpmn:script>url = "https://api.anthropic.com/v1/messages"
apikey = ""
anthropic_version = "2023-06-01"
model = "claude-sonnet-4-20250514"

headers = {
    "x-api-key": apikey,
    "anthropic-version": anthropic_version,
    "content-type": "application/json" 
}

system = """
You are a friendly and conversational and direct real estate agent
You are honest and up front about being an AI.
You only ask one question at a time.
Your sole mission is to complete this json schema: """ + json.dumps(schema)


tool_description = """
Saves responses from the user as json.
Use as often as possible to save information, while you continue to ask additional questions.
The tool does not provide any information when executed.
"""

initial_message = """
I am new to house buying. I am not sure where 
to start.  Please ask me questions to help me 
get oriented.
"""


tools = [
  {
  "name": "update_json",
  "description": tool_description,
  "input_schema": {
    "additionalProperties": False,
    "properties": {
      "json": {
        "description": "The json data that is the collected so far.",
        "type": "object"
      }
    },
    "required": ["json"],
    "type": "object"
  }
}
]

data = {
    "system": system,
    "messages": [
      {"role": "user",
       "content": initial_message}
    ],
    "model": "claude-sonnet-4-20250514",
    "max_tokens": 512,
    "tools": tools
}
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0f3vf1a" name="Call The LLM">
      <bpmn:extensionElements>
        <spiffworkflow:postScript>response = api_response["body"]
tool_call = ""
content = ""
contents = response.get("content")
user_responses = {}
is_complete = False
for content in contents:
  if content["type"] == "text":
    user_message = content["text"]
  if content["type"] == "tool_use":
    user_responses = content["input"]["json"]
  
</spiffworkflow:postScript>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="url" />
            <spiffworkflow:parameter id="headers" type="any" value="headers" />
            <spiffworkflow:parameter id="data" type="any" value="data" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wmu1kd</bpmn:incoming>
      <bpmn:outgoing>Flow_0ptrgjx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1ltnks7" default="Flow_0zzvof7">
      <bpmn:incoming>Flow_0vdux9a</bpmn:incoming>
      <bpmn:outgoing>Flow_0zzvof7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0vhfhef</bpmn:outgoing>
      <bpmn:outgoing>Flow_1xcn4aq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_1qxawxs" name="Check Responses">
      <bpmn:incoming>Flow_0ptrgjx</bpmn:incoming>
      <bpmn:outgoing>Flow_0vdux9a</bpmn:outgoing>
      <bpmn:script>if "workingWithAgent" in user_responses:
  workingWithAgent = user_responses["workingWithAgent"]
else:
  workingWithAgent = False

is_complete = True
required = ["workingWithAgent", "transactionType", "timeline"]
for r in required:
  if r not in user_responses:
    is_complete = False

</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_1abc1ff">
      <bpmn:incoming>Flow_1ffhwhd</bpmn:incoming>
    </bpmn:endEvent>
