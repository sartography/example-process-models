    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1l5jpji">
      <bpmn:incoming>Flow_04f33n0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04f33n0" name="stop" sourceRef="Gateway_1dfj9la" targetRef="Event_1l5jpji">
      <bpmn:conditionExpression>new_prompt=="stop"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
