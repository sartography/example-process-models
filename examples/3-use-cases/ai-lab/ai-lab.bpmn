<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:process id="Process_CompareTemperaturesAgent" name="Add Your API Keys Here!" isExecutable="true">
    <bpmn:serviceTask id="Activity_16evkuv" name="Ask the AI">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="url" />
            <spiffworkflow:parameter id="headers" type="any" value="headers" />
            <spiffworkflow:parameter id="data" type="any" value="data" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:postScript>message = api_response["body"]["choices"][0]["message"]["content"]</spiffworkflow:postScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13yzqu7</bpmn:incoming>
      <bpmn:outgoing>Flow_16r6gep</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Activity_1st72q6" name="Present Results">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser># The response is
{{message}}
</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16r6gep</bpmn:incoming>
      <bpmn:outgoing>Flow_139dife</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_06j97qs">
      <bpmn:incoming>Flow_139dife</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_16r6gep" sourceRef="Activity_16evkuv" targetRef="Activity_1st72q6" />
