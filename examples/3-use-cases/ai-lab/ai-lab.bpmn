<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:process id="Process_CompareTemperaturesAgent" name="Add Your API Keys Here!" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_0l70b6x" sourceRef="Activity_13ifnen" targetRef="Activity_0mflkvo" />
    <bpmn:sequenceFlow id="Flow_0sz5gi2" sourceRef="Activity_0mflkvo" targetRef="Activity_1gay05n" />
    <bpmn:endEvent id="Event_0cw1sn4">
      <bpmn:incoming>Flow_03numl1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03numl1" sourceRef="Activity_1gay05n" targetRef="Event_0cw1sn4" />
    <bpmn:scriptTask id="Activity_13ifnen" name="Is it safe for me to exercise today?">
      <bpmn:incoming>Flow_1yrgbbo</bpmn:incoming>
      <bpmn:outgoing>Flow_0l70b6x</bpmn:outgoing>
      <bpmn:script>url = "https://api.hyperbolic.xyz/v1/completions"

hyperbolic_api_key = "ENTER YOUR KEY HERE"

headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer " + hyperbolic_api_key
}

# This is a base model.  It has not had post training.
# It will likely not pattern it's response to emulate a
# conversation.
model = "meta-llama/Meta-Llama-3.1-405B" 


data = {
    "prompt": "Is it safe for me to exercise outside today?",
    "model": "meta-llama/Meta-Llama-3.1-405B",
    "max_tokens": 25,
    "temperature": 0.7,
    "top_p": 0.9
}
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0mflkvo" name="Ask the AI">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="url" />
            <spiffworkflow:parameter id="headers" type="any" value="headers" />
            <spiffworkflow:parameter id="data" type="any" value="data" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:postScript>message = api_response["body"]["choices"][0]["text"]</spiffworkflow:postScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0l70b6x</bpmn:incoming>
      <bpmn:outgoing>Flow_0sz5gi2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Activity_1gay05n" name="Present Results">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser># The response is
{{message}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sz5gi2</bpmn:incoming>
      <bpmn:outgoing>Flow_03numl1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Activity_16evkuv" name="Ask the AI">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="url" />
