<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_artemis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="3.0.0-dev">
  <bpmn:collaboration id="Collaboration_artemis">
    <bpmn:participant id="Participant_artemis" name="Artemis II Mission" processRef="Process_artemis_ii" />
    <bpmn:correlationKey id="CorrelationKey_1shovpi" name="MainCorrelationKey">
      <bpmn:correlationPropertyRef>mission</bpmn:correlationPropertyRef>
    </bpmn:correlationKey>
  </bpmn:collaboration>
  <bpmn:process id="Process_artemis_ii" name="Artemis II Mission" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_FlightCrew" name="Flight Crew">
        <bpmn:flowNodeRef>crew_readiness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reentry_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0rbwknu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MissionControl" name="Mission Control">
        <bpmn:flowNodeRef>end_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch_subprocess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch_weather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evaluate_conditions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>monitor_telemetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallel_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_trajectory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mission_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FlightDirector" name="Flight Director">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>go_no_go_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>launch_decision_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scrub_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scrub_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configure_mission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1i4z8o5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="go_no_go_decision" name="Go / No-Go Decision">
      <bpmn:extensionElements>
        <spiffworkflow:calledDecisionId>go_no_go_decision_table</spiffworkflow:calledDecisionId>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="launch_decision_gw" name="Launch Decision" default="Flow_no_go">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_go</bpmn:outgoing>
      <bpmn:outgoing>Flow_no_go</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="scrub_report" name="Generate Scrub Report" scriptFormat="python">
      <bpmn:incoming>Flow_no_go</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:script>
scrub_reason = decision_rationale
next_launch_window = "48 hours from original launch time"
scrub_summary = "Mission " + mission_name + " launch scrubbed. Reason: " + decision_rationale + ". Next window: " + next_launch_window
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="crew_readiness" name="Crew Readiness Check">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="crew-readiness-schema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:instructionsForEndUser># Crew Readiness Verification

All four crew members must complete suit-up and systems verification before boarding the Orion spacecraft at Launch Complex 39B.

| Role | Astronaut |
|------|-----------|
| Commander | {{commander}} |
| Pilot | {{pilot}} |
| Mission Specialist 1 | {{mission_specialist_1}} |
| Mission Specialist 2 | {{mission_specialist_2}} |

**Launch Site:** {{launch_site}}
**Vehicle:** {{vehicle}}
**Weather Status:** {{weather_status}}
**Systems Status:** {{systems_status}}
**Decision:** {{decision_rationale}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_go</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_event" name="Mission Complete">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="reentry_prep" name="Re-Entry Preparation" spiffworkflow:isMatchingCorrelation="true">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="reentry-checklist-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="reentry-checklist-uischema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:instructionsForEndUser># Re-Entry Preparation

Orion is approaching Earth. Complete the re-entry preparation checklist before atmospheric interface.

**Re-Entry Angle:** {{reentry_angle_degrees}} degrees
**Re-Entry Speed:** {{reentry_speed_km_s}} km/s
**Splashdown Target:** {{splashdown_target}}
**Estimated Splashdown:** {{estimated_splashdown}}
**Recovery Ship:** {{recovery_ship}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="launch_subprocess" name="Launch &#38; Earth Departure">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:startEvent id="sub_start">
        <bpmn:outgoing>Sub_Flow_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="launch_countdown" name="Execute Launch Countdown" scriptFormat="python">
        <bpmn:incoming>Sub_Flow_01</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_02</bpmn:outgoing>
        <bpmn:script>
# SLS launch sequence
countdown_complete = True
launch_time = "T+00:00:00"
srb_separation_complete = True
core_stage_separation = True
altitude_km = 0
velocity_km_s = 0
        </bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="tli_burn" name="Trans-Lunar Injection Burn" scriptFormat="python">
        <bpmn:extensionElements>
          <spiffworkflow:instructionsForEndUser>Executing Trans-Lunar Injection burn to leave Earth orbit and set course for the Moon.</spiffworkflow:instructionsForEndUser>
        </bpmn:extensionElements>
        <bpmn:incoming>Sub_Flow_02</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_03</bpmn:outgoing>
        <bpmn:script>
# ICPS Trans-Lunar Injection burn
orbit_achieved = True
tli_burn_duration_seconds = 350
delta_v_km_s = 3.1
trajectory = "free-return lunar flyby"
altitude_km = 185
velocity_km_s = 10.8
estimated_lunar_arrival = "Mission Day 4"
        </bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="sub_end">
        <bpmn:incoming>Sub_Flow_03</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Flow_01" sourceRef="sub_start" targetRef="launch_countdown" />
      <bpmn:sequenceFlow id="Sub_Flow_02" sourceRef="launch_countdown" targetRef="tli_burn" />
      <bpmn:sequenceFlow id="Sub_Flow_03" sourceRef="tli_burn" targetRef="sub_end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Activity_1i4z8o5" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="fetch_weather" targetRef="evaluate_conditions" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="evaluate_conditions" targetRef="go_no_go_decision" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="go_no_go_decision" targetRef="launch_decision_gw" />
    <bpmn:sequenceFlow id="Flow_go" name="Go" sourceRef="launch_decision_gw" targetRef="crew_readiness">
      <bpmn:conditionExpression>launch_decision == "go"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_no_go" name="No-Go" sourceRef="launch_decision_gw" targetRef="scrub_report" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="scrub_report" targetRef="scrub_end" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="crew_readiness" targetRef="launch_subprocess" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="launch_subprocess" targetRef="parallel_split" />
    <bpmn:receiveTask id="lunar_observations" name="Lunar Observations" spiffworkflow:isMatchingCorrelation="true">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="lunar-observations-schema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:instructionsForEndUser># Lunar Flyby Observations

The Orion spacecraft is now performing its closest approach to the Moon. Record observations and instrument readings.

**Trajectory:** {{trajectory}}
**Velocity:** {{velocity_km_s}} km/s
**Estimated Lunar Arrival:** {{estimated_lunar_arrival}}</spiffworkflow:instructionsForEndUser>
        <spiffworkflow:processVariableCorrelation>
          <spiffworkflow:propertyId>mission</spiffworkflow:propertyId>
          <spiffworkflow:expression>"artemis"</spiffworkflow:expression>
        </spiffworkflow:processVariableCorrelation>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="parallel_split" targetRef="lunar_observations" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="parallel_split" targetRef="monitor_telemetry" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="lunar_observations" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="monitor_telemetry" targetRef="parallel_join" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="parallel_join" targetRef="return_trajectory" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="return_trajectory" targetRef="reentry_prep" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="reentry_prep" targetRef="mission_report" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="mission_report" targetRef="end_event" />
    <bpmn:endEvent id="scrub_end" name="Mission Scrubbed">
      <bpmn:incoming>Flow_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="fetch_weather" name="Fetch Launch Weather">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/GetRequest">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="&#39;https://api.weather.gov/stations/KTTS/observations/latest&#39;" />
            <spiffworkflow:parameter id="headers" type="any" value="{&#39;User-Agent&#39;: &#39;SpiffWorkflow-ArtemisDemo&#39;}" />
            <spiffworkflow:parameter id="params" type="any" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_192yn7a</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="evaluate_conditions" name="Evaluate Launch Conditions" scriptFormat="python">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:script>
# Set mission identifier for message correlation
mission_id = "ARTEMIS-II"

# Evaluate weather conditions for launch
# In a real scenario these would come from the weather service task
weather_status = "green"
systems_status = "nominal"
launch_site = "Kennedy Space Center, LC-39B"
vehicle = "SLS Block 1 / Orion MPCV"
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="monitor_telemetry" name="Monitor Spacecraft Telemetry" scriptFormat="python">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:script>
# Telemetry readings during lunar flyby
spacecraft_health = "nominal"
power_levels_percent = 94
oxygen_levels_percent = 99
radiation_levels = "within acceptable limits"
communication_signal = "strong"
distance_from_earth_km = 380000
lunar_closest_approach_km = 8900
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="parallel_split">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="parallel_join">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="return_trajectory" name="Calculate Return Trajectory" scriptFormat="python">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:script>
# Calculate Earth return trajectory after lunar flyby
reentry_angle_degrees = -6.2
reentry_speed_km_s = 11.0
splashdown_target = "Pacific Ocean, off San Diego"
estimated_splashdown = "Mission Day 10"
recovery_ship = "USS Portland (LPD-27)"
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="mission_report" name="Generate Mission Report" scriptFormat="python">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:script>
mission_status = "complete"
total_duration_days = mission_duration_days
max_distance_from_earth_km = 400171
objectives_met = True
crew_members = commander + ", " + pilot + ", " + mission_specialist_1 + ", " + mission_specialist_2
mission_summary = "Artemis II successfully completed a " + str(total_duration_days) + "-day lunar flyby mission. Crew: " + crew_members + ". Maximum distance from Earth: " + str(max_distance_from_earth_km) + " km. Closest lunar approach: " + str(lunar_closest_approach_km) + " km. Splashdown: " + splashdown_target + "."
      </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="configure_mission" name="Configure Mission Parameters">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="mission-parameters-schema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:instructionsForEndUser># Artemis II Mission Configuration

Configure the parameters for NASA's Artemis II crewed lunar flyby mission — the first crewed voyage beyond low Earth orbit since Apollo 17 in 1972.

The crew of four will orbit the Moon and return to Earth over approximately 10 days aboard the Orion spacecraft, launched on the Space Launch System (SLS) from Kennedy Space Center.</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tzwutg</bpmn:incoming>
      <bpmn:outgoing>Flow_192yn7a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_192yn7a" sourceRef="configure_mission" targetRef="fetch_weather" />
    <bpmn:userTask id="Activity_0rbwknu">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="mission-parameters-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="lunar-observations-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1tzwutg" sourceRef="Activity_1i4z8o5" targetRef="configure_mission" />
    <bpmn:receiveTask id="Activity_1i4z8o5" name="Test Message" messageRef="remote_update" spiffworkflow:isMatchingCorrelation="true">
      <bpmn:extensionElements>
        <spiffworkflow:processVariableCorrelation>
          <spiffworkflow:propertyId>mission</spiffworkflow:propertyId>
          <spiffworkflow:expression>"artemis"</spiffworkflow:expression>
        </spiffworkflow:processVariableCorrelation>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_1tzwutg</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:dataObject id="DataObject_1127vky" name="Data Object 1127 Vky" />
  </bpmn:process>
  <bpmn:message id="observations" name="observations" />
  <bpmn:message id="remote_update" name="remote_update" />
  <bpmn:correlationProperty id="mission" name="mission">
    <bpmn:correlationPropertyRetrievalExpression messageRef="remote_update">
      <bpmn:formalExpression>mission</bpmn:formalExpression>
    </bpmn:correlationPropertyRetrievalExpression>
  </bpmn:correlationProperty>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_artemis">
      <bpmndi:BPMNShape id="Participant_artemis_di" bpmnElement="Participant_artemis" isHorizontal="true">
        <dc:Bounds x="665" y="5" width="2320" height="660" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_FlightDirector_di" bpmnElement="Lane_FlightDirector" isHorizontal="true">
        <dc:Bounds x="695" y="5" width="2290" height="190" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_MissionControl_di" bpmnElement="Lane_MissionControl" isHorizontal="true">
        <dc:Bounds x="695" y="195" width="2290" height="240" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_FlightCrew_di" bpmnElement="Lane_FlightCrew" isHorizontal="true">
        <dc:Bounds x="695" y="435" width="2290" height="230" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="735" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="go_no_go_decision_di" bpmnElement="go_no_go_decision">
        <dc:Bounds x="1395" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="launch_decision_gw_di" bpmnElement="launch_decision_gw" isMarkerVisible="true">
        <dc:Bounds x="1545" y="75" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1529" y="51" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="scrub_report_di" bpmnElement="scrub_report">
        <dc:Bounds x="1645" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="crew_readiness_di" bpmnElement="crew_readiness">
        <dc:Bounds x="1645" y="510" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="2837" y="297" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2811" y="340" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_15jawxv_di" bpmnElement="reentry_prep">
        <dc:Bounds x="2555" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="launch_subprocess_di" bpmnElement="launch_subprocess" isExpanded="false">
        <dc:Bounds x="1835" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="scrub_end_di" bpmnElement="scrub_end">
        <dc:Bounds x="1797" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1771" y="125" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fetch_weather_di" bpmnElement="fetch_weather">
        <dc:Bounds x="1070" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluate_conditions_di" bpmnElement="evaluate_conditions">
        <dc:Bounds x="1220" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="monitor_telemetry_di" bpmnElement="monitor_telemetry">
        <dc:Bounds x="2135" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel_split_di" bpmnElement="parallel_split">
        <dc:Bounds x="2030" y="290" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel_join_di" bpmnElement="parallel_join">
        <dc:Bounds x="2300" y="290" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="return_trajectory_di" bpmnElement="return_trajectory">
        <dc:Bounds x="2390" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mission_report_di" bpmnElement="mission_report">
        <dc:Bounds x="2700" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="configure_mission_di" bpmnElement="configure_mission">
        <dc:Bounds x="980" y="60" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0gcn58w_di" bpmnElement="Activity_0rbwknu">
        <dc:Bounds x="980" y="470" width="100" height="80" />
