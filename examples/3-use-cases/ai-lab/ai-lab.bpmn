    <bpmn:sequenceFlow id="Flow_13yzqu7" sourceRef="Activity_0sc9um2" targetRef="Activity_16evkuv" />
    <bpmn:scriptTask id="Activity_0sc9um2" name="Is it safe for me to exercise today?">
      <bpmn:outgoing>Flow_13yzqu7</bpmn:outgoing>
      <bpmn:script>url = "https://api.hyperbolic.xyz/v1/chat/completions"

hyperbolic_api_key = ""

headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer " + hyperbolic_api_key
}

data = {
    "messages": [{
      "role": "user",
      "content": "Is it safe to exercise outside today?"
    }],
    "model": "meta-llama/Llama-3.3-70B-Instruct",
    "max_tokens": 512,
    "temperature": 0.1,
    "top_p": 0.9
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0b3w3se" name="Ask the AI">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="url" />
            <spiffworkflow:parameter id="headers" type="any" value="headers" />
            <spiffworkflow:parameter id="data" type="any" value="data" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:postScript>message = api_response["body"]["choices"][0]["message"]["content"]</spiffworkflow:postScript>
        <spiffworkflow:instructionsForEndUser></spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10rvxap</bpmn:incoming>
      <bpmn:outgoing>Flow_01za4vd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_0n6jsrk" name="Is it safe for me to exercise today?">
      <bpmn:incoming>Flow_0qr5ghq</bpmn:incoming>
      <bpmn:outgoing>Flow_0gpori6</bpmn:outgoing>
      <bpmn:script>url = "https://api.hyperbolic.xyz/v1/chat/completions"
headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJkYW5Ac3BpZmYud29ya3MiLCJpYXQiOjE3NTUzNjkxNjl9.xb88yYT9OnrcG4zmpi7yGVRts9HGz8mn8_dW6Txq67U"
}
data = {
    "messages": [{
      "role": "user",
      "content": "Is it safe to exercise outside today?"
    }],
    "model": "meta-llama/Llama-3.3-70B-Instruct",
    "max_tokens": 50,
    "temperature": 0.1,
    "top_p": 0.9
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0gpori6" sourceRef="Activity_0n6jsrk" targetRef="Gateway_0opunjy" />
    <bpmn:sequenceFlow id="Flow_01za4vd" sourceRef="Activity_0b3w3se" targetRef="Activity_1kfcdee" />
    <bpmn:sequenceFlow id="Flow_1b32iiv" sourceRef="Activity_1kfcdee" targetRef="Gateway_1dfj9la" />
    <bpmn:userTask id="Activity_1kfcdee" name="Present Results and new prompt">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>{% for message in data["messages"] %}
* **{{ message.role | capitalize }}:** {{ message.content | truncate(200) }}

{% endfor %}
* **Assistant**: {{message}}</spiffworkflow:instructionsForEndUser>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="prompt-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="prompt-uischema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:postScript># add in the new response from the LLM
data["messages"].append(api_response["body"]["choices"][0]["message"])

# Add in the new prompt from the person
data["messages"].append({"role":"user", "content": new_prompt})</spiffworkflow:postScript>
        <spiffworkflow:preScript>new_prompt = ""</spiffworkflow:preScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01za4vd</bpmn:incoming>
      <bpmn:outgoing>Flow_1b32iiv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1dfj9la" default="Flow_1k4bytr">
      <bpmn:incoming>Flow_1b32iiv</bpmn:incoming>
      <bpmn:outgoing>Flow_04f33n0</bpmn:outgoing>
      <bpmn:outgoing>Flow_1k4bytr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1l5jpji">
      <bpmn:incoming>Flow_04f33n0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04f33n0" name="stop" sourceRef="Gateway_1dfj9la" targetRef="Event_1l5jpji">
      <bpmn:conditionExpression>new_prompt=="stop"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0opunjy">
      <bpmn:incoming>Flow_0gpori6</bpmn:incoming>
      <bpmn:incoming>Flow_1k4bytr</bpmn:incoming>
      <bpmn:outgoing>Flow_10rvxap</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10rvxap" sourceRef="Gateway_0opunjy" targetRef="Activity_0b3w3se" />
    <bpmn:sequenceFlow id="Flow_1k4bytr" name="This is just a loop" sourceRef="Gateway_1dfj9la" targetRef="Gateway_0opunjy" />
    <bpmn:endEvent id="Event_0qe55yc">
      <bpmn:incoming>Flow_1m99zhy</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Activity_0edgvl6" name="Set the Prompt">
      <bpmn:outgoing>Flow_0fnftef</bpmn:outgoing>
      <bpmn:script>url = "https://api.hyperbolic.xyz/v1/completions"

hyperbolic_api_key = ""


headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer " + hyperbolic_api_key
}

model = "meta-llama/Llama-3.3-70B-Instruct"

data = {
    "prompt": "Is it safe to exercise outside today?",
    "model": model,
    "max_tokens": 25,
    "temperature": 0.7,
    "top_p": 0.9
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0oijucu" name="Ask the AI">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequest" resultVariable="api_response">
          <spiffworkflow:parameters>
